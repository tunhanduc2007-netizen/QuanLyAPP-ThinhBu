rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // 1. DỮ LIỆU CÁ NHÂN CHUẨN HÓA (NORMALIZED SUBCOLLECTIONS: users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Chỉ chủ sở hữu token (request.auth.uid == userId) mới có quyền đọc và ghi
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection: Giao dịch độc lập (Loại bỏ Single JSON Blob)
      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (!('amount' in request.resource.data) || (request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 1000000000000000));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Số dư các tài khoản ví (Ngân hàng, Tiền mặt)
      match /wallets/{walletId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (!('balance' in request.resource.data) || (request.resource.data.balance is number));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Ngân sách chi tiêu
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Mục tiêu tài chính
      match /goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =========================================================================
    // 2. DỮ LIỆU CŨ (LEGACY COMPATIBILITY: fintrack_user_data/{docId})
    // =========================================================================
    match /fintrack_user_data/{docId} {
      allow read, write: if request.auth != null && docId == ('user_' + request.auth.uid);
      allow delete: if false;
    }

    // =========================================================================
    // 3. QUẢN LÝ NHÓM DÙNG CHUNG (MULTI-TENANT GROUPS & RBAC)
    // =========================================================================
    match /groups/{groupId} {
      function isMember() {
        return request.auth != null && (
          (resource != null && request.auth.uid in resource.data.members) ||
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        );
      }

      function isAdmin() {
        return request.auth != null && (
          (resource != null && resource.data.adminUid == request.auth.uid) ||
          (get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin')
        );
      }

      function isViewer() {
        return request.auth != null && 
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'viewer';
      }

      // Đọc thông tin nhóm: Chỉ thành viên trong nhóm
      allow read: if isMember();

      // Cập nhật thông tin nhóm / Đổi quyền Admin: Chỉ Admin
      allow update, delete: if isAdmin();

      // Tạo nhóm mới: Chỉ khi người tạo tự đặt mình làm adminUid
      allow create: if request.auth != null && request.resource.data.adminUid == request.auth.uid;

      // Danh sách thành viên trong nhóm (RBAC)
      match /members/{memberUid} {
        allow read: if isMember();
        // Chỉ Admin mới được thêm/sửa/xóa thành viên hoặc đổi role
        allow write: if isAdmin();
      }

      // Giao dịch chi tiêu của nhóm
      match /transactions/{txId} {
        allow read: if isMember();
        // Thành viên có role Member hoặc Admin mới được thêm giao dịch (Viewer bị chặn)
        allow create: if isMember() && !isViewer();
        // Admin hoặc người tạo giao dịch mới được sửa/xóa
        allow update, delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
      }
    }

    // =========================================================================
    // 4. BẢNG XẾP HẠNG TOÀN HỆ THỐNG (GLOBAL LEADERBOARD & PRIVACY)
    // =========================================================================
    match /leaderboards/{period}/entries/{entryUid} {
      // Bất kỳ ai đã đăng nhập đều có thể đọc bảng xếp hạng (dữ liệu đã được mask danh tính)
      allow read: if request.auth != null;
      // Người dùng chỉ được ghi điểm xếp hạng của chính mình
      allow write: if request.auth != null && request.auth.uid == entryUid;
    }

    // =========================================================================
    // 5. MẶC ĐỊNH: CHẶN TOÀN BỘ MỌI ĐƯỜNG DẪN KHÁC (STRICT DEFAULT DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
